---
import '../styles/global.css';
import SupportBanner from '../components/SupportBanner.astro';
import HouseSwitch from '../components/HouseSwitch.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  house: 'skandale' | 'skattejaegeren';
  iframeSrc: string;
}

const { title, description, house, iframeSrc } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = `${title} · Folkets Medie`;
const site = String(import.meta.env.SITE || 'https://mattomadsen.github.io').replace(/\/$/, '');
const canonical = `${site}${base}${house}/`;
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0b0c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <ClientRouter />
  </head>
  <body class="app-shell">
    <div class="site-top">
      <HouseSwitch current={house} />
      <SupportBanner />
    </div>
    <iframe
      class="app-frame"
      src={iframeSrc}
      title={title}
      transition:persist={`frame-${house}`}
    ></iframe>
  </body>
</html>
