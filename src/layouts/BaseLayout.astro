---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const {
  title,
  description = 'Folkets Medie — artikler og dokumentar (arkiv).',
  current,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === 'Folkets Medie' ? title : `${title} · Folkets Medie`;
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="logo" href={base}>Folkets <span>Medie</span></a>
        <nav class="nav" aria-label="Menu">
          <a href={base} aria-current={current === 'home' ? 'page' : undefined}>Artikler</a>
          <a href={`${base}dokumentar/`} aria-current={current === 'dokumentar' ? 'page' : undefined}>Dokumentar</a>
          <a href={`${base}nyttige-links/`} aria-current={current === 'links' ? 'page' : undefined}>Links</a>
          <a href={`${base}om/`} aria-current={current === 'om' ? 'page' : undefined}>Om</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>Folkets Medie · statisk arkiv · video streamer fra Rumble m.fl.</p>
    </footer>
  </body>
</html>
