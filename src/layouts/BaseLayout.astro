---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const { title, description = 'Arkiv af Folkets Medie — artikler, dokumentar og links.', current } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === 'Folkets Medie' ? title : `${title} · Folkets Medie`;
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="logo" href={base}>Folkets <span>Medie</span></a>
        <nav class="nav" aria-label="Hovedmenu">
          <a href={base} aria-current={current === 'home' ? 'page' : undefined}>Artikler</a>
          <a href={`${base}dokumentar/`} aria-current={current === 'dokumentar' ? 'page' : undefined}>Dokumentar</a>
          <a href={`${base}nyttige-links/`} aria-current={current === 'links' ? 'page' : undefined}>Nyttige links</a>
          <a href={`${base}om/`} aria-current={current === 'om' ? 'page' : undefined}>Om FM</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          Statisk arkiv baseret på backup fra <strong>september 2023</strong>.
          Indhold © Folkets Medie.
        </p>
        <p>
          Nye artikler kan tilføjes her efterhånden —
          <a href="https://www.folketsmedie.dk" rel="noopener">folketsmedie.dk</a>
        </p>
      </div>
    </footer>
  </body>
</html>
