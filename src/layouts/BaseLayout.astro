---
import '../styles/global.css';
import SearchBox from '../components/SearchBox.astro';
import SupportBanner from '../components/SupportBanner.astro';
import HouseSwitch from '../components/HouseSwitch.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  current?: string;
  /** Absolute page URL for Open Graph / Twitter */
  pageUrl?: string;
  /** Absolute image URL for social previews (og:image) */
  image?: string | null;
  /** og:type — article or website */
  ogType?: 'article' | 'website';
}

const {
  title,
  description = 'Folkets Medie — nyheder, artikler og dokumentar. Statisk arkiv.',
  current,
  pageUrl,
  image,
  ogType = 'website',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === 'Folkets Medie' ? `${title} · Nyheder fra folket` : `${title} · Folkets Medie`;

const site = String(import.meta.env.SITE || 'https://mattomadsen.github.io').replace(/\/$/, '');

function toAbsolute(url: string | null | undefined): string | undefined {
  if (!url) return undefined;
  const u = url.trim();
  if (!u) return undefined;
  if (/^https?:\/\//i.test(u)) return u;
  const path = u.startsWith('/') ? u : `/${u}`;
  return `${site}${path}`;
}

const canonical =
  toAbsolute(pageUrl) ||
  toAbsolute(`${base}`.replace(/\/?$/, '/') ) ||
  `${site}${base.endsWith('/') ? base : `${base}/`}`;

const defaultShareImage = toAbsolute(`${base}media/featured/folkets-medie-paa-github-laptop.jpg`);
const ogImage = toAbsolute(image) || defaultShareImage;
const desc = (description || '').replace(/\s+/g, ' ').trim().slice(0, 300);
---

<!doctype html>
<html lang="da" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#0a0b0c" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Open Graph (Facebook, LinkedIn, m.fl.) -->
    <meta property="og:site_name" content="Folkets Medie" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <link rel="image_src" href={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={title} />}
    {ogImage && ogImage.toLowerCase().endsWith('.png') && <meta property="og:image:type" content="image/png" />}
    {ogImage && (ogImage.toLowerCase().endsWith('.jpg') || ogImage.toLowerCase().endsWith('.jpeg')) && (
      <meta property="og:image:type" content="image/jpeg" />
    )}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={title} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="site-top">
    <HouseSwitch current="fm" />
    <SupportBanner />
    <header class="site-header">
      <div class="site-header__inner">
        <a class="logo" href={base}>
          Folkets <span>Medie</span>
          <small>Nyheder</small>
        </a>
        <nav class="nav" aria-label="Hovedmenu">
          <a href={base} aria-current={current === 'home' ? 'page' : undefined}>Artikler</a>
          <a href={`${base}dokumentar/`} aria-current={current === 'dokumentar' ? 'page' : undefined}>Dokumentar</a>
          <a href={`${base}nyttige-links/`} aria-current={current === 'links' ? 'page' : undefined}>Links</a>
          <a href={`${base}stoet/`} aria-current={current === 'stoet' ? 'page' : undefined}>Støt</a>
          <a href={`${base}om/`} aria-current={current === 'om' ? 'page' : undefined}>Om</a>
        </nav>
        <SearchBox id="nav-q" compact />
      </div>
    </header>
    </div>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p><strong>Folkets Medie</strong> — nyheder fra folket til folket</p>
        <p>
          Video streamer fra Rumble, Bitchute m.fl. · Statisk arkiv ·
          <a href={`${base}stoet/`}>Støt os</a>
        </p>
      </div>
    </footer>
  </body>
</html>
