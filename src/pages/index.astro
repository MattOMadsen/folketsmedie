---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, articleImage, formatDate } from '../lib/content';

const articles = getArticles();
const [featured, ...rest] = articles;
const base = import.meta.env.BASE_URL;
const featImg = featured ? articleImage(featured, base) : null;
const excerpt =
  featured?.excerpt ||
  (featured?.content || '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 220);
const site = String(import.meta.env.SITE || 'https://mattomadsen.github.io').replace(/\/$/, '');
const homeUrl = `${site}${base.endsWith('/') ? base : `${base}/`}`;
const homeOgImage =
  featImg && /^https?:\/\//i.test(featImg)
    ? featImg
    : featImg
      ? `${site}${featImg.startsWith('/') ? featImg : `/${featImg}`}`
      : null;
---

<BaseLayout
  title="Folkets Medie"
  current="home"
  description="Nyheder, artikler og dokumentar fra Folkets Medie."
  pageUrl={homeUrl}
  image={homeOgImage}
  ogType="website"
>
  <header class="page-intro">
    <h1>Nyheder fra folket til folket</h1>
    <p>{articles.length} artikler · uafhængigt arkiv uden WordPress · <a href={`${base}soeg/`}>søg i arkivet</a></p>
  </header>

  {
    featured && (
      <a class="hero-feature" href={`${base}artikel/${featured.slug}/`}>
        <div class="hero-feature__media">
          {featImg ? (
            <img src={featImg} alt="" width="800" height="500" />
          ) : (
            <div class="card__ph" style="min-height:280px;height:100%">Folkets Medie</div>
          )}
        </div>
        <div class="hero-feature__body">
          <span class="hero-feature__label">Seneste</span>
          <h2 class="hero-feature__title">{featured.title}</h2>
          {excerpt && <p class="hero-feature__excerpt">{excerpt}{excerpt.length >= 220 ? '…' : ''}</p>}
          <time class="hero-feature__meta" datetime={featured.date}>
            {formatDate(featured.date)}
          </time>
        </div>
      </a>
    )
  }

  <div class="section-label">
    <h2>Alle artikler</h2>
    <span>{rest.length} mere</span>
  </div>

  <div class="grid">
    {rest.map((a) => <ArticleCard article={a} />)}
  </div>
</BaseLayout>
