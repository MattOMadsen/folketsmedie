---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVideos, formatDate } from '../../lib/content';

const videos = getVideos();
const base = import.meta.env.BASE_URL;
const withEmbed = videos.filter((v) => v.embed_html).length;
---

<BaseLayout title="Dokumentar" description="Dokumentarfilm — stream via Rumble m.fl." current="dokumentar">
  <header class="page-intro">
    <h1>Dokumentar</h1>
    <p>
      {videos.length} videoer · afspilles fra Rumble / YouTube (intet upload til GitHub)
      {withEmbed ? ` · ${withEmbed} med embed` : ''}
    </p>
  </header>

  <div class="grid">
    {
      videos.map((v) => (
        <article class="card">
          <a href={`${base}dokumentar/${v.slug}/`}>
            {v.featured_image ? (
              <img class="card__img" src={v.featured_image} alt="" loading="lazy" />
            ) : (
              <div class="card__ph">▶ Video</div>
            )}
            <div class="card__body">
              <time class="card__date" datetime={v.date}>
                {formatDate(v.date)}
              </time>
              <h2 class="card__title">{v.title}</h2>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</BaseLayout>
