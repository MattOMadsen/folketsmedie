---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVideos, videoImage } from '../../lib/content';

const videos = getVideos();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Dokumentar" description="Dokumentarfilm fra Folkets Medie" current="dokumentar">
  <header class="page-intro">
    <h1>Dokumentar film</h1>
    <p>
      {videos.length} film · afspilles fra Rumble, Bitchute, YouTube m.fl.
    </p>
  </header>

  <div class="grid">
    {
      videos.map((v) => (
        <article class="card">
          <a href={`${base}dokumentar/${v.slug}/`}>
            {videoImage(v, base) ? (
              <img class="card__img" src={videoImage(v, base)!} alt="" loading="lazy" />
            ) : (
              <div class="card__ph">▶ Film</div>
            )}
            <div class="card__body">
              <h2 class="card__title">{v.title}</h2>
              {v.episode_count && v.episode_count > 1 ? (
                <p class="card__date">{v.episode_count} dele</p>
              ) : (
                <p class="card__date">Dokumentar</p>
              )}
            </div>
          </a>
        </article>
      ))
    }
  </div>
</BaseLayout>
