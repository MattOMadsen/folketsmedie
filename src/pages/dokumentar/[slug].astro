---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EngageBar from '../../components/EngageBar.astro';
import { getVideos, getVideo, cleanHtml, shareTeaser, shareImageUrl, videoImage, videoWatchLinks } from '../../lib/content';

export function getStaticPaths() {
  return getVideos().map((v) => ({
    params: { slug: v.slug },
  }));
}

const { slug } = Astro.params;
const video = getVideo(slug!);
if (!video) throw new Error(`Documentary not found: ${slug}`);

// Prefer extracted stream embeds; fall back to cleaned page body (no raw AIOVG junk)
const base = import.meta.env.BASE_URL;
const body = cleanHtml(video.content || '', base);
// Strip aiovg gallery HTML noise from body if we have embeds
const showBody = !video.embed_html && body.length > 80;

const site = String(import.meta.env.SITE || 'https://mattomadsen.github.io').replace(/\/$/, '');
const path = `${base}dokumentar/${video.slug}/`.replace(/\/{2,}/g, '/');
const shareUrl = `${site}${path.startsWith('/') ? path : `/${path}`}`;
const shareText = shareTeaser({
  title: video.title,
  excerpt: video.excerpt,
  content: video.content,
  max: 240,
});
const poster = videoImage(video, base);
const ogImage = shareImageUrl(poster, site);
const watchLinks = videoWatchLinks(
  `${video.embed_html || ''} ${video.watch_url ? `href="${video.watch_url}"` : ''}`
);
---

<BaseLayout
  title={video.title}
  description={shareText || video.title}
  current="dokumentar"
  pageUrl={shareUrl}
  image={ogImage}
  ogType="article"
>
  <article class="narrow">
    <a class="back" href={`${base}dokumentar/`}>← Dokumentar</a>
    <header class="article-header">
      <h1>{video.title}</h1>
    </header>

    {
      video.embed_html ? (
        <div class="doc-player" set:html={cleanHtml(video.embed_html, base)} />
      ) : poster ? (
        <img class="featured" src={poster} alt="" />
      ) : null
    }
    {
      watchLinks.length > 0 && (
        <p class="video-link">
          {watchLinks.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
          ))}
        </p>
      )
    }

    <EngageBar
      placement="top"
      slug={video.slug}
      title={video.title}
      url={shareUrl}
      text={shareText}
    />

    {
      showBody && <div class="prose" set:html={body} />
    }

    <EngageBar
      placement="bottom"
      slug={video.slug}
      title={video.title}
      url={shareUrl}
      text={shareText}
    />
  </article>
</BaseLayout>
