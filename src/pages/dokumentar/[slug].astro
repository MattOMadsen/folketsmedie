---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVideos, getVideo, cleanHtml, formatDate } from '../../lib/content';

export function getStaticPaths() {
  return getVideos().map((v) => ({
    params: { slug: v.slug },
  }));
}

const { slug } = Astro.params;
const video = getVideo(slug!);
if (!video) throw new Error(`Video not found: ${slug}`);

const body = cleanHtml(video.content || '');
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={video.title} current="dokumentar">
  <article class="narrow">
    <a class="back" href={`${base}dokumentar/`}>← Dokumentar</a>
    <header class="article-header">
      <time class="meta-line" datetime={video.date}>{formatDate(video.date)}</time>
      <h1>{video.title}</h1>
    </header>

    {
      video.embed_html ? (
        <div set:html={video.embed_html} />
      ) : video.watch_url ? (
        <p class="video-link">
          <a href={video.watch_url} target="_blank" rel="noopener">
            Se video ↗
          </a>
        </p>
      ) : video.featured_image ? (
        <img class="featured" src={video.featured_image} alt="" />
      ) : null
    }

    {body && <div class="prose" set:html={body} />}
  </article>
</BaseLayout>
