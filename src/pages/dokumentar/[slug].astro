---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EngageBar from '../../components/EngageBar.astro';
import { getVideos, getVideo, cleanHtml } from '../../lib/content';

export function getStaticPaths() {
  return getVideos().map((v) => ({
    params: { slug: v.slug },
  }));
}

const { slug } = Astro.params;
const video = getVideo(slug!);
if (!video) throw new Error(`Documentary not found: ${slug}`);

// Prefer extracted stream embeds; fall back to cleaned page body (no raw AIOVG junk)
const base = import.meta.env.BASE_URL;
const body = cleanHtml(video.content || '', base);
// Strip aiovg gallery HTML noise from body if we have embeds
const showBody = !video.embed_html && body.length > 80;

const site = String(import.meta.env.SITE || 'https://mattomadsen.github.io').replace(/\/$/, '');
const path = `${base}dokumentar/${video.slug}/`.replace(/\/{2,}/g, '/');
const shareUrl = `${site}${path.startsWith('/') ? path : `/${path}`}`;
const shareText = (video.excerpt || video.title).replace(/\s+/g, ' ').trim().slice(0, 200);
const ogImage = video.featured_image
  ? /^https?:\/\//i.test(video.featured_image)
    ? video.featured_image
    : `${site}${video.featured_image.startsWith('/') ? video.featured_image : `/${video.featured_image}`}`
  : null;
---

<BaseLayout
  title={video.title}
  description={video.excerpt || video.title}
  current="dokumentar"
  pageUrl={shareUrl}
  image={ogImage}
  ogType="article"
>
  <article class="narrow">
    <a class="back" href={`${base}dokumentar/`}>← Dokumentar</a>
    <header class="article-header">
      <h1>{video.title}</h1>
    </header>

    {
      video.embed_html ? (
        <div class="doc-player" set:html={video.embed_html} />
      ) : video.featured_image ? (
        <img class="featured" src={video.featured_image} alt="" />
      ) : null
    }

    <EngageBar
      placement="top"
      slug={video.slug}
      title={video.title}
      url={shareUrl}
      text={shareText}
    />

    {
      showBody && <div class="prose" set:html={body} />
    }

    <EngageBar
      placement="bottom"
      slug={video.slug}
      title={video.title}
      url={shareUrl}
      text={shareText}
    />
  </article>
</BaseLayout>
