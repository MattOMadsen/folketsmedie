---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVideos, getVideo, cleanHtml } from '../../lib/content';

export function getStaticPaths() {
  return getVideos().map((v) => ({
    params: { slug: v.slug },
  }));
}

const { slug } = Astro.params;
const video = getVideo(slug!);
if (!video) throw new Error(`Documentary not found: ${slug}`);

// Prefer extracted stream embeds; fall back to cleaned page body (no raw AIOVG junk)
const base = import.meta.env.BASE_URL;
const body = cleanHtml(video.content || '', base);
// Strip aiovg gallery HTML noise from body if we have embeds
const showBody = !video.embed_html && body.length > 80;
---

<BaseLayout title={video.title} current="dokumentar">
  <article class="narrow">
    <a class="back" href={`${base}dokumentar/`}>← Dokumentar</a>
    <header class="article-header">
      <h1>{video.title}</h1>
    </header>

    {
      video.embed_html ? (
        <div class="doc-player" set:html={video.embed_html} />
      ) : video.featured_image ? (
        <img class="featured" src={video.featured_image} alt="" />
      ) : null
    }

    {
      showBody && <div class="prose" set:html={body} />
    }
  </article>
</BaseLayout>
