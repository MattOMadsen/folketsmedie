---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVideos, getVideo, cleanHtml, formatDate } from '../../lib/content';

export function getStaticPaths() {
  return getVideos().map((v) => ({
    params: { slug: v.slug },
  }));
}

const { slug } = Astro.params;
const video = getVideo(slug!);
if (!video) throw new Error(`Video not found: ${slug}`);

const body = cleanHtml(video.content);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={video.title} current="dokumentar">
  <article class="narrow">
    <a class="back" href={`${base}dokumentar/`}>← Dokumentar</a>
    <header class="article-header">
      <time class="article-meta" datetime={video.date}>{formatDate(video.date)}</time>
      <h1>{video.title}</h1>
    </header>
    {
      video.featured_image && (
        <img class="featured" src={video.featured_image} alt="" />
      )
    }
    <div class="prose" set:html={body} />
  </article>
</BaseLayout>
