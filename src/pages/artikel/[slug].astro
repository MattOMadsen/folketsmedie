---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EngageBar from '../../components/EngageBar.astro';
import {
  getArticles,
  getArticle,
  cleanHtml,
  formatDate,
  articleImage,
} from '../../lib/content';

export function getStaticPaths() {
  return getArticles().map((a) => ({
    params: { slug: a.slug },
  }));
}

const { slug } = Astro.params;
const article = getArticle(slug!);
if (!article) throw new Error(`Article not found: ${slug}`);

const base = import.meta.env.BASE_URL;
const body = cleanHtml(article.content, base);
const img = articleImage(article, base);

const site = String(import.meta.env.SITE || 'https://mattomadsen.github.io').replace(/\/$/, '');
const path = `${base}artikel/${article.slug}/`.replace(/\/{2,}/g, '/');
const shareUrl = `${site}${path.startsWith('/') ? path : `/${path}`}`;
const shareText = (article.excerpt || article.title).replace(/\s+/g, ' ').trim().slice(0, 200);
---

<BaseLayout title={article.title} description={article.excerpt || article.title} current="home">
  <article class="narrow">
    <a class="back" href={base}>← Alle artikler</a>
    <header class="article-header">
      <time class="meta-line" datetime={article.date}>{formatDate(article.date)}</time>
      <h1>{article.title}</h1>
    </header>
    {img && <img class="featured" src={img} alt="" loading="eager" />}
    <EngageBar
      placement="top"
      slug={article.slug}
      title={article.title}
      url={shareUrl}
      text={shareText}
    />
    <div class="prose" set:html={body} />
    <EngageBar
      placement="bottom"
      slug={article.slug}
      title={article.title}
      url={shareUrl}
      text={shareText}
    />
  </article>
</BaseLayout>
