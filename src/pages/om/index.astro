---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { data, cleanHtml } from '../../lib/content';

const page = data.pages.om;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Om Folkets Medie" current="om">
  <article class="narrow">
    <header class="page-intro">
      <h1>{page?.title || 'Om Folkets Medie'}</h1>
    </header>
    {
      page ? (
        <div class="prose" set:html={cleanHtml(page.content, base)} />
      ) : (
        <p>Indhold mangler.</p>
      )
    }
  </article>
</BaseLayout>
