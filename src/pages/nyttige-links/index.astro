---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { data, cleanHtml } from '../../lib/content';

const page = data.pages.nyttige_links;
---

<BaseLayout title="Nyttige links" current="links">
  <article class="narrow">
    <header class="page-intro">
      <h1>{page?.title || 'Nyttige links'}</h1>
    </header>
    {
      page ? (
        <div class="prose" set:html={cleanHtml(page.content)} />
      ) : (
        <p>Indhold mangler.</p>
      )
    }
  </article>
</BaseLayout>
