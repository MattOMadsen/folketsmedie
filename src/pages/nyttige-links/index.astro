---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { linkGroups } from '../../lib/links';

const base = import.meta.env.BASE_URL;

function hrefFor(slug: string) {
  if (slug === 'udenlandske-medier') return `${base}udenlandske-medier/`;
  return `${base}nyttige-links/${slug}/`;
}
---

<BaseLayout
  title="Nyttige links"
  description="Danske medier, video-podcasts, Telegram-grupper og udenlandske sider fra Folkets Medie."
  current="links"
>
  <header class="page-intro">
    <h1>Nyttige links</h1>
    <p>
      Listerne er fra den gamle Folkets Medie-side. Linkene går ud af arkivet — nogle sider
      kan være flyttet eller lukket.
    </p>
  </header>

  <div class="grid">
    {
      linkGroups.map((g) => (
        <article class="card">
          <a href={hrefFor(g.slug)}>
            <img class="card__img" src={`${base}${g.image.replace(/^\//, '')}`} alt="" loading="lazy" />
            <div class="card__body">
              <p class="card__date">{g.kicker}</p>
              <h2 class="card__title">{g.title}</h2>
              <p class="card__date">{g.intro}</p>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</BaseLayout>
