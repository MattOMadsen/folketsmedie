---
const base = import.meta.env.BASE_URL;
---

<link rel="manifest" href={`${base}manifest.webmanifest`} />
<link rel="apple-touch-icon" sizes="180x180" href={`${base}icons/apple-touch-icon.png`} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />
<meta name="apple-mobile-web-app-title" content="FM" />
<script is:inline define:vars={{ base }}>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register(base + 'sw.js', { scope: base, updateViaCache: 'none' });
  }
</script>
