---
interface Props {
  title: string;
  /** Absolute public URL of this page */
  url: string;
  /** Optional short teaser for e-mail / Web Share */
  text?: string;
}

const { title, url, text = '' } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const teaser = (text || '').trim();
const parts = [title.trim()];
if (teaser && teaser !== title.trim()) parts.push(teaser);
parts.push(`Læs mere her:\n${url}`);
const composed = parts.join('\n\n');
const encodedComposed = encodeURIComponent(composed);

const xHref = `https://twitter.com/intent/tweet?text=${encodedComposed}`;
const fbHref = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const tgHref = `https://t.me/share/url?url=${encodedUrl}&text=${encodeURIComponent(
  [title.trim(), teaser && teaser !== title.trim() ? teaser : '', 'Læs mere her:'].filter(Boolean).join('\n\n')
)}`;
const mailHref = `mailto:?subject=${encodedTitle}&body=${encodedComposed}`;
---

<div class="share-bar" data-share-url={url} data-share-title={title} data-share-text={composed}>
  <span class="share-bar__label">Del</span>
  <div class="share-bar__actions">
    <a
      class="share-btn share-btn--x"
      href={xHref}
      target="_blank"
      rel="noopener noreferrer"
      title="Del på X"
      aria-label="Del på X"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"
        ><path
          fill="currentColor"
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"
        ></path></svg
      >
      <span>X</span>
    </a>
    <a
      class="share-btn share-btn--fb"
      href={fbHref}
      target="_blank"
      rel="noopener noreferrer"
      title="Del på Facebook"
      aria-label="Del på Facebook"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"
        ><path
          fill="currentColor"
          d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.49 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"
        ></path></svg
      >
      <span>Facebook</span>
    </a>
    <a
      class="share-btn share-btn--tg"
      href={tgHref}
      target="_blank"
      rel="noopener noreferrer"
      title="Del på Telegram"
      aria-label="Del på Telegram"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"
        ><path
          fill="currentColor"
          d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
        ></path></svg
      >
      <span>Telegram</span>
    </a>
    <a class="share-btn share-btn--mail" href={mailHref} title="Send som e-mail" aria-label="Send som e-mail">
      <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"
        ><path d="M4 6h16v12H4z"></path><path d="m4 7 8 6 8-6"></path></svg
      >
      <span>E-mail</span>
    </a>
    <button type="button" class="share-btn share-btn--copy" data-share-copy title="Kopiér link" aria-label="Kopiér link">
      <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"
        ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg
      >
      <span data-share-copy-label>Kopiér link</span>
    </button>
  </div>
</div>

<script>
  function initShareBars() {
    document.querySelectorAll<HTMLElement>('.share-bar').forEach((bar) => {
      if (bar.dataset.shareReady === '1') return;
      bar.dataset.shareReady = '1';

      const url = bar.dataset.shareUrl || location.href;
      const title = bar.dataset.shareTitle || document.title;
      const text = bar.dataset.shareText || title;

      const copyBtn = bar.querySelector<HTMLButtonElement>('[data-share-copy]');
      const copyLabel = bar.querySelector<HTMLElement>('[data-share-copy-label]');

      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(text.includes(url) ? text : `${text}\n\nLæs mere her:\n${url}`);
          if (copyLabel) {
            const prev = copyLabel.textContent;
            copyLabel.textContent = 'Kopieret!';
            copyBtn.classList.add('is-copied');
            setTimeout(() => {
              copyLabel.textContent = prev || 'Kopiér link';
              copyBtn.classList.remove('is-copied');
            }, 1800);
          }
        } catch {
          // Fallback for older browsers
          window.prompt('Kopiér linket:', url);
        }
      });

      // Native share on devices that support it (mobile)
      if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') {
        const native = document.createElement('button');
        native.type = 'button';
        native.className = 'share-btn share-btn--native';
        native.title = 'Del via enhed';
        native.setAttribute('aria-label', 'Del via enhed');
        native.innerHTML =
          '<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg><span>Del</span>';
        native.addEventListener('click', async () => {
          try {
            await navigator.share({
              title,
              text: text.includes(url) ? text : `${text}\n\nLæs mere her:\n${url}`,
              url,
            });
          } catch {
            /* cancelled */
          }
        });
        bar.querySelector('.share-bar__actions')?.prepend(native);
      }
    });
  }

  initShareBars();
  document.addEventListener('astro:page-load', initShareBars);
</script>
