---
interface Props {
  current?: 'fm' | 'skandale' | 'skattejaegeren';
}
const { current = 'fm' } = Astro.props;
const base = import.meta.env.BASE_URL;

const sites = [
  { id: 'fm', label: 'Folkets Medie', href: base },
  { id: 'skandale', label: 'Skandale', href: `${base}skandale/` },
  { id: 'skattejaegeren', label: 'Skattejægeren', href: `${base}skattejaegeren/` },
] as const;
---

<nav class="house-switch" aria-label="Vælg sted">
  <div class="house-switch__inner">
    {sites.map((s) => (
      <a
        href={s.href}
        aria-current={current === s.id ? 'page' : undefined}
      >{s.label}</a>
    ))}
  </div>
</nav>
