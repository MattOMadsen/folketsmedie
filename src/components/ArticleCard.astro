---
import { formatDate, articleImage, type Article } from '../lib/content';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}artikel/${article.slug}/`;
const img = articleImage(article, base);
---

<article class="card">
  <a href={href}>
    {
      img ? (
        <img class="card__img" src={img} alt="" loading="lazy" width="640" height="400" />
      ) : (
        <div class="card__ph">Folkets Medie</div>
      )
    }
    <div class="card__body">
      <time class="card__date" datetime={article.date}>{formatDate(article.date)}</time>
      <h2 class="card__title">{article.title}</h2>
    </div>
  </a>
</article>
