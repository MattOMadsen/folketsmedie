---
import { formatDate, type Article } from '../lib/content';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}artikel/${article.slug}/`;
---

<article class="card">
  <a href={href}>
    {
      article.featured_image ? (
        <img
          class="card__img"
          src={article.featured_image}
          alt=""
          loading="lazy"
          width="640"
          height="400"
        />
      ) : (
        <div class="card__img-placeholder">Folkets Medie</div>
      )
    }
    <div class="card__body">
      <time class="card__date" datetime={article.date}>{formatDate(article.date)}</time>
      <h2 class="card__title">{article.title}</h2>
    </div>
  </a>
</article>
